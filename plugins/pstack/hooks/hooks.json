{
  "description": "Persist explicitly enabled Poteto Mode within its Codex session and project.",
  "hooks": {
    "UserPromptSubmit": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/hooks/poteto-mode.mjs\"",
        "timeout": 5,
        "additionalContextLimit": 1500
      }]
    }],
    "SessionStart": [{
      "matcher": "^(resume|compact)$",
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/hooks/poteto-mode.mjs\"",
        "timeout": 5,
        "additionalContextLimit": 1500
      }]
    }],
    "SubagentStart": [{
      "hooks": [{
        "type": "command",
        "command": "node \"$PLUGIN_ROOT/hooks/poteto-mode.mjs\"",
        "timeout": 5,
        "additionalContextLimit": 1500
      }]
    }]
  }
}
